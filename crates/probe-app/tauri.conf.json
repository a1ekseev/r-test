{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Probe",
  "version": "0.1.0",
  "identifier": "dev.probe.demo",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Probe", "width": 900, "height": 600, "create": false }],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data: blob: probe: http://probe.localhost http://127.0.0.1:*",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
